# Copy to .env.local and adjust.

# --- Server-only (never exposed to the browser) ---

# Base URL of the CampusLink backend (Express API). Server Actions, the proxy and the /bff relay call it.
API_URL=http://localhost:4000

# Optional: force the Secure flag of the session cookies (default: Secure only when NODE_ENV=production).
# Set to "false" to run a production build (`next start`) over plain http, e.g. for local E2E tests.
# COOKIE_SECURE=false

# Optional: number of reverse proxies in front of Next.js that append the client address to X-Forwarded-For
# (default 0). With 0, no X-Forwarded-For is sent to the backend: a client could write anything in it, and the
# backend trusts Next.js (TRUST_PROXY=loopback) for the audit log IP and the rate limits. The backend then sees
# Next.js (loopback) for every web user, so only the per-email rate limits apply to web users (the per-IP limits
# are not applied to loopback callers without X-Forwarded-For).
# In production, run Next.js behind a reverse proxy that OVERWRITES the header with the real address, e.g. nginx
# `proxy_set_header X-Forwarded-For $remote_addr;`, and set TRUSTED_PROXY_HOPS=1. With N proxies, the address
# written by the outermost one (the N-th entry from the end) is forwarded. Keep TRUST_PROXY=loopback on the backend.
# TRUSTED_PROXY_HOPS=0

# Optional: build/output folder (default ".next"). Lets several builds of this folder run side by side,
# e.g. NEXT_DIST_DIR=.next-e2e for the test suite. Folders named .next-* are git-ignored.
# NEXT_DIST_DIR=.next

# --- Public (inlined in the browser bundle at build time) ---

# Campus timezone: every displayed date/time and every "today"/"this week" range uses it.
NEXT_PUBLIC_APP_TIMEZONE=Africa/Tunis

# The service worker (offline mode, push) is registered in production builds only.
# Set to "true" to also register it with `next dev` (remember to unregister it afterwards).
# NEXT_PUBLIC_ENABLE_SW=true

# Phase 3: public URL of the real-time server (the API, Socket.IO) used by the browser for the carpool chat.
# Also allowed in the Content-Security-Policy (connect-src).
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
