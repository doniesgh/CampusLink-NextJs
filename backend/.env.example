# CampusLink backend configuration.
# Copy this file to backend/.env and fill in the values. Never commit backend/.env.
# Variables already set in the shell environment take precedence over this file.

# HTTP port of the API.
PORT=4000

# MongoDB connection string (required).
MONGO_URI=mongodb://localhost:27017/campuslink

# Secret used to sign access tokens (required). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-value

# Access token lifetime (jsonwebtoken format: 15m, 1h, ...).
JWT_ACCESS_TTL=15m

# Refresh token lifetime, in days.
REFRESH_TOKEN_TTL_DAYS=30

# Wrong one-time codes allowed before the pending code is cancelled.
OTP_MAX_ATTEMPTS=5

# Web origins allowed by CORS, comma-separated. The mobile app does not need an entry.
CORS_ORIGINS=http://localhost:3000

# Public URL of the web app, used to build links in emails (password reset).
APP_URL=http://localhost:3000

# SMTP settings. When SMTP_USER or SMTP_PASS is empty, emails are NOT sent:
# the backend prints them in the console instead (local development).
# For Gmail, use an app password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CampusLink <no-reply@example.com>

# Optional: also append every email as one JSON line to this file (used by end-to-end tests).
MAIL_OUTBOX_FILE=
