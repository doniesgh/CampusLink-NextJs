# CampusLink backend configuration.
# Copy this file to backend/.env and fill in the values. Never commit backend/.env.
# Variables already set in the shell environment take precedence over this file.

# HTTP port of the API.
PORT=4000

# MongoDB connection string (required).
MONGO_URI=mongodb://localhost:27017/campuslink

# Secret used to sign access tokens (required). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-value

# Access token lifetime (jsonwebtoken format: 15m, 1h, ...).
JWT_ACCESS_TTL=15m

# Refresh token lifetime, in days.
REFRESH_TOKEN_TTL_DAYS=30

# Wrong one-time codes allowed before the pending code is cancelled.
OTP_MAX_ATTEMPTS=5

# Web origins allowed by CORS, comma-separated. The mobile app does not need an entry.
CORS_ORIGINS=http://localhost:3000

# Public URL of the web app, used to build links in emails (password reset).
APP_URL=http://localhost:3000

# Public URL of this API, used in links given to other apps (calendar subscription URLs).
PUBLIC_API_URL=http://localhost:4000

# Campus timezone (IANA name): "this week", "today", CSV import times and notification dates use it.
APP_TIMEZONE=Africa/Tunis

# SMTP settings. When SMTP_USER or SMTP_PASS is empty, emails are NOT sent:
# the backend prints them in the console instead (local development).
# With NODE_ENV=production, sending email fails instead (codes and links are never logged).
# For Gmail, use an app password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CampusLink <no-reply@example.com>

# Optional: also append every email as one JSON line to this file (used by end-to-end tests).
MAIL_OUTBOX_FILE=

# Web push (VAPID). Generate a key pair with: npm run generate-vapid
# Without keys, GET /api/push/vapid-public-key answers 503 PUSH_DISABLED and no push is sent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@campuslink.local

# Optional (tests): append every push as one JSON line to this file instead of sending it.
PUSH_OUTBOX_FILE=

# Uploaded files (announcement attachments). Relative paths are relative to backend/.
STORAGE_DIR=uploads
# Maximum size of one uploaded file, in MB.
MAX_UPLOAD_MB=10

# Background jobs (e.g. publishing scheduled announcements): delay between two runs, in ms.
SCHEDULER_INTERVAL_MS=30000

# Timetable changes notify students and teachers when the session starts within this many days.
NOTIFY_HORIZON_DAYS=14

# Express "trust proxy": which proxies may set X-Forwarded-For (the Next.js server runs on loopback).
# Values: loopback, a hop count (1), addresses/subnets ("loopback, 10.0.0.0/8"), true or false.
TRUST_PROXY=loopback

# Rate limiting of the auth routes (429 TOO_MANY_REQUESTS). "false" disables every limiter (tests).
RATE_LIMIT_ENABLED=true
# Length of a rate limiting window, in ms (shared by the auth limiters below; bookings have their own window).
RATE_LIMIT_WINDOW_MS=900000
# login, verify-otp, forgot-password and signup: requests per window per route + IP + email.
RATE_LIMIT_AUTH_MAX=20
# The same four routes together: requests per window per IP, whatever the email.
# Not applied to loopback callers without X-Forwarded-For; set TRUSTED_PROXY_HOPS on the web app so it
# forwards the client IP (with TRUSTED_PROXY_HOPS=0, web users only get the per route + IP + email limit).
RATE_LIMIT_IP_MAX=100
# change-password: requests per window per signed-in user.
RATE_LIMIT_PASSWORD_MAX=10
# reset-password: requests per window per IP.
# Not applied to loopback callers without X-Forwarded-For; set TRUSTED_PROXY_HOPS on the web app so it
# forwards the client IP.
RATE_LIMIT_RESET_MAX=20

# Phase 2. Bookings: reminder sent this many minutes before a confirmed booking starts.
BOOKING_REMINDER_MINUTES=60
# Bookings: requests per user per window (429 TOO_MANY_REQUESTS; RATE_LIMIT_ENABLED=false disables them too).
# Every PENDING request notifies the admins, so create / cancel loops are bounded. Admin cancellations are not limited.
RATE_LIMIT_BOOKING_CREATE_MAX=30
RATE_LIMIT_BOOKING_CANCEL_MAX=30
# Length of the bookings window, in ms (default 1 hour).
RATE_LIMIT_BOOKING_WINDOW_MS=3600000
# Attendance: absence rate (unexcused absent hours / held hours, per subject) that triggers a warning, then an alert.
ABSENCE_WARNING_RATE=0.10
ABSENCE_ALERT_RATE=0.20
# Per-user limits (requests per hour): forum posts (questions, answers, reports) and PDF report downloads.
RATE_LIMIT_FORUM_POST_MAX=30
RATE_LIMIT_REPORT_MAX=20

# Phase 3. Campus location (carpool destination) and carpool settings.
CAMPUS_LAT=36.8992
CAMPUS_LNG=10.1897
CAMPUS_LABEL=ESPRIT Ghazela
CARPOOL_SEARCH_RADIUS_KM=5
# Suggested shared cost: distance (km) x cost per km / (seats + 1), in dinars.
CARPOOL_COST_PER_KM=0.25
# Notes marketplace: fictitious tokens given to every user on first use.
MARKET_STARTING_TOKENS=100

# Per-user write limits of the modules (requests per window; RATE_LIMIT_ENABLED=false disables them all).
RATE_LIMIT_FORUM_WINDOW_MS=3600000
RATE_LIMIT_REPORT_WINDOW_MS=3600000
RATE_LIMIT_BOOKING_CREATE_MAX=30
RATE_LIMIT_BOOKING_CANCEL_MAX=30
RATE_LIMIT_BOOKING_WINDOW_MS=3600000
RATE_LIMIT_CARPOOL_TRIP_MAX=20
RATE_LIMIT_CARPOOL_UPDATE_MAX=20
RATE_LIMIT_CARPOOL_REQUEST_MAX=30
RATE_LIMIT_CARPOOL_WINDOW_MS=3600000
RATE_LIMIT_CARPOOL_MESSAGE_MAX=30
RATE_LIMIT_CARPOOL_MESSAGE_WINDOW_MS=60000
RATE_LIMIT_REALTIME_TICKET_MAX=60
RATE_LIMIT_MARKET_UPLOAD_MAX=10
RATE_LIMIT_MARKET_REPORT_MAX=20
RATE_LIMIT_MARKET_WINDOW_MS=3600000
RATE_LIMIT_ALUMNI_POST_MAX=10
RATE_LIMIT_ALUMNI_POST_WINDOW_MS=86400000
RATE_LIMIT_MENTORING_MAX=10
RATE_LIMIT_MENTORING_WINDOW_MS=86400000
